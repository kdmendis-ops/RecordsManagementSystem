### Health check
GET {{baseUrl}}/health

### Register a user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test Admin",
  "email": "admin@example.com",
  "password": "Password123!",
  "role": "admin"
}

### Login (copy the returned token into @token above)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Password123!"
}

### CREATE - add a new survey
POST {{baseUrl}}/surveys
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Patient Satisfaction Survey",
  "description": "Quick feedback after a visit",
  "department": "Cardiology",
  "status": "published",
  "questions": [
    { "prompt": "How satisfied were you with your visit?", "type": "rating", "required": true },
    { "prompt": "Any additional comments?", "type": "text", "required": false }
  ]
}

### READ - list all surveys
GET {{baseUrl}}/surveys

### READ - get a single survey by id
@surveyId = 6a5abee766f9b6213d06f345
GET {{baseUrl}}/surveys/{{surveyId}}

### UPDATE - edit a survey
PATCH {{baseUrl}}/surveys/{{surveyId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Patient Satisfaction Survey (Updated)",
  "status": "closed"
}

### DELETE - remove a survey
DELETE {{baseUrl}}/surveys/{{surveyId}}
Authorization: Bearer {{token}}
